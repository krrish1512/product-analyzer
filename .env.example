POSTGRES_PASSWORD=local-only-password
DATABASE_URL=postgresql://postgres:local-only-password@localhost:5432/pricewise
PORT=3000
NODE_ENV=development
DB_POOL_MAX=10
TRUST_PROXY=0
REAL_DATA_SYNC_ENABLED=true
PRODUCT_CACHE_TTL_MINUTES=180

# Optional marketplace integrations. Leave blank to keep the app running with demo data.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
SERPAPI_API_KEY=
OPENWEBNINJA_API_KEY=
OPENWEBNINJA_BASE_URL=https://api.openwebninja.com
